/* Add these functions to the EXISTING Apps Script Code.gs.
   Keep your existing setup/getData/addTransaction/updateTransaction/deleteTransaction/
   saveBudget/deleteBudget/setOpeningBalance/saveCategories/saveMonthlyReport functions. */
function doGet(e){var p=(e&&e.parameter)||{},action=p.action||'getData',result;try{if(action==='getData')result=getData(p.month||'');else result={error:'Unknown action'};}catch(err){result={error:String(err&&err.message||err)}}var json=JSON.stringify(result);if(p.callback)return ContentService.createTextOutput(p.callback+'('+json+');').setMimeType(ContentService.MimeType.JAVASCRIPT);return ContentService.createTextOutput(json).setMimeType(ContentService.MimeType.JSON)}
function doPost(e){var p=(e&&e.parameter)||{},a=p.action;try{switch(a){case'addTransaction':addTransaction({type:p.type,amount:Number(p.amount),category:p.category,remark:p.remark||''});break;case'updateTransaction':updateTransaction({id:p.id,type:p.type,amount:Number(p.amount),category:p.category,remark:p.remark||''});break;case'deleteTransaction':deleteTransaction(p.id);break;case'saveBudget':saveBudget({month:p.month,category:p.category,allocated:Number(p.allocated||0),recurringAmount:Number(p.recurringAmount||0),recurringDays:Number(p.recurringDays||0)});break;case'deleteBudget':deleteBudget(p.month,p.category);break;case'setOpeningBalance':setOpeningBalance(p.month,Number(p.amount||0));break;case'saveCategories':saveCategories(JSON.parse(p.categories||'[]'));break;case'saveMonthlyReport':saveMonthlyReport(p.month);break;default:throw Error('Unknown action: '+a)}}catch(err){return HtmlService.createHtmlOutput('<!doctype html><html><body>'+String(err.message||err)+'</body></html>')}return HtmlService.createHtmlOutput('<!doctype html><html><body>OK</body></html>')}
